			.footer-brand .footer-tagline { color: var(--text-dim); font-size: 0.92rem; margin: 1rem 0 1.5rem; }
			.footer-col h3 { font-family: var(--font-display); font-size: 1.4rem; margin: 0 0 1.2rem; }
			.footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
			.footer-col a { color: var(--text-dim); text-decoration: none; font-size: 0.92rem; transition: color 0.2s ease; }
			.footer-col a:hover { color: var(--accent); }
			.social-badge { display: inline-flex; align-items: center; margin-right: 0.5rem; color: var(--accent); }
			.social-label em { display: block; font-style: normal; font-size: 0.78rem; color: var(--text-dim); }
			.footer-contact .footer-btn { margin-bottom: 0.6rem; }
			.footer-note { font-size: 0.78rem; color: var(--text-dim); margin: 0; }
			.footer-bar { max-width: 82rem; margin: 0 auto; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; font-size: 0.82rem; color: var(--text-dim); }

