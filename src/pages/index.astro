		<script>
			const root = document.documentElement;
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// --- Seguidor de Cursor para Iluminación Leve de Rejillas ---
			if (!reduceMotion) {
				window.addEventListener('pointermove', (e) => {
					const x = (e.clientX / window.innerWidth) * 100;
					const y = (e.clientY / window.innerHeight) * 100;
					root.style.setProperty('--mouse-x', `${x.toFixed(2)}%`);
					root.style.setProperty('--mouse-y', `${y.toFixed(2)}%`);
				}, { passive: true });
			}

			// --- Theme toggle -----------------------------------------------------
			const toggle = document.querySelector('[data-theme-toggle]');
			const syncToggle = () => {
				toggle?.setAttribute('aria-pressed', root.getAttribute('data-theme') === 'light' ? 'true' : 'false');
			};
			syncToggle();
			toggle?.addEventListener('click', () => {
				const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
				root.setAttribute('data-theme', next);
				try { localStorage.setItem('fv-theme', next); } catch (e) {}
				syncToggle();
			});

			// --- Stat count-up ----------------------------------------------------
			const counters = document.querySelectorAll('[data-count-to]');
			const animateCount = (el: Element) => {
				const target = Number(el.getAttribute('data-count-to'));
				if (reduceMotion) {
					el.textContent = String(target);
					return;
				}
				const duration = 1100;
				const start = Date.now();
				const timer = window.setInterval(() => {
					const progress = Math.min((Date.now() - start) / duration, 1);
					const eased = 1 - Math.pow(1 - progress, 3);
					el.textContent = String(Math.round(eased * target));
					if (progress >= 1) window.clearInterval(timer);
				}, 16);
			};
			const statsBlock = document.querySelector('[data-stats]');
			if (statsBlock) {
				let started = false;
				const start = () => {
					if (started) return;
					started = true;
					counters.forEach(animateCount);
				};
				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							start();
							observer.disconnect();
						}
					});
				}, { threshold: 0.15 });
				observer.observe(statsBlock);
				window.setTimeout(start, 900);
			}

			// --- Carousel (Auto-scroll a 1.0s exacto y arrastre con mouse) -----------
			const carousel = document.querySelector('[data-carousel]');
			if (carousel) {
				const slides = Array.from(carousel.querySelectorAll('[data-slide]'));
				const dots = Array.from(carousel.querySelectorAll('[data-carousel-dot]'));
				const total = slides.length;
				let index = 0;
				let timer = 0;

				const render = () => {
					const prev = (index - 1 + total) % total;
					const next = (index + 1) % total;
					slides.forEach((slide, i) => {
						slide.classList.toggle('is-current', i === index);
						slide.classList.toggle('is-prev', i === prev);
						slide.classList.toggle('is-next', i === next);
						const offstage = i !== index && i !== prev && i !== next;
						slide.toggleAttribute('inert', offstage);
						slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
					});
					dots.forEach((dot, i) => {
						dot.classList.toggle('is-active', i === index);
						dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
					});
				};

				const go = (to: number) => {
					index = (to + total) % total;
					render();
				};

				const stop = () => {
					if (timer) { window.clearInterval(timer); timer = 0; }
				};
				const play = () => {
					if (reduceMotion || timer) return;
					// Cambia a 1.0s exacto (1000ms)
					timer = window.setInterval(() => go(index + 1), 1000);
				};

				carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => { stop(); go(index - 1); play(); });
				carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => { stop(); go(index + 1); play(); });
				dots.forEach((dot, i) => dot.addEventListener('click', () => { stop(); go(i); play(); }));

				carousel.addEventListener('mouseenter', stop);
				carousel.addEventListener('mouseleave', play);
				carousel.addEventListener('focusin', stop);
				carousel.addEventListener('focusout', play);

				// Arrastre con Mouse / Touch Swipe (Deslizar con mouse en PC y táctil en celular)
				const stage = carousel.querySelector('[data-carousel-stage]') as HTMLElement | null;
				if (stage) {
					let downX = 0;
					let downY = 0;
					let dragging = false;
					let isDragGesture = false;
					const THRESHOLD = 25;

					stage.style.cursor = 'grab';

					stage.addEventListener('pointerdown', (e: PointerEvent) => {
						if (e.button !== 0 && e.pointerType === 'mouse') return;
						downX = e.clientX;
						downY = e.clientY;
						dragging = true;
						isDragGesture = false;
						stage.style.cursor = 'grabbing';
						stop();
					});

					stage.addEventListener('pointermove', (e: PointerEvent) => {
						if (!dragging) return;
						const dx = e.clientX - downX;
						const dy = e.clientY - downY;
						if (Math.abs(dx) > 6 || Math.abs(dy) > 6) {
							isDragGesture = true;
						}
					});

					stage.addEventListener('pointerup', (e: PointerEvent) => {
						if (!dragging) return;
						dragging = false;
						stage.style.cursor = 'grab';
						const dx = e.clientX - downX;
						const dy = e.clientY - downY;
						if (Math.abs(dx) > THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
							go(dx < 0 ? index + 1 : index - 1);
						}
						play();
					});

					stage.addEventListener('pointercancel', () => {
						dragging = false;
						stage.style.cursor = 'grab';
						play();
					});

					// Abrir lightbox únicamente con clic normal (evitar abrir al arrastrar con el mouse)
					stage.querySelectorAll('[data-open-lightbox]').forEach((btn) => {
						btn.addEventListener('click', (e) => {
							if (isDragGesture) {
								e.preventDefault();
								e.stopPropagation();
								e.stopImmediatePropagation();
								isDragGesture = false;
							}
						}, true);
					});
				}

				render();
				play();
			}

			// --- FAQ Accordion exclusivo (cierra los anteriores al abrir uno) -----
			const faqItems = document.querySelectorAll('.faq-item');
			faqItems.forEach((item) => {
				item.addEventListener('toggle', () => {
					if ((item as HTMLDetailsElement).open) {
						faqItems.forEach((other) => {
							if (other !== item) (other as HTMLDetailsElement).removeAttribute('open');
						});
					}
				});
			});

			// --- Lightbox ---------------------------------------------------------
			const lightbox = document.querySelector('[data-lightbox]');
			if (lightbox) {
				const lbMedia = lightbox.querySelector('[data-lightbox-media]') as HTMLElement;
				const lbImg = document.createElement('img');
				lbImg.decoding = 'async';
				lbImg.onload = () => {
					if (lbImg.naturalWidth && lbImg.naturalHeight) {
						lbMedia.style.aspectRatio = `${lbImg.naturalWidth} / ${lbImg.naturalHeight}`;
					}
				};
				lbMedia.appendChild(lbImg);
				const lbTitle = lightbox.querySelector('[data-lightbox-title]') as HTMLElement;
				const lbTag = lightbox.querySelector('[data-lightbox-tag]') as HTMLElement;
				const lbCounter = lightbox.querySelector('[data-lightbox-counter]') as HTMLElement;
				const closeBtn = lightbox.querySelector('.lightbox-close') as HTMLElement;
				let openers: HTMLElement[] = [];
				let position = 0;
				let lastFocused: HTMLElement | null = null;

				const visibleOpeners = () =>
					Array.from(document.querySelectorAll('[data-open-lightbox]')) as HTMLElement[];

				const show = (i: number) => {
					position = (i + openers.length) % openers.length;
					const btn = openers[position];
					const aspect = btn.getAttribute('data-aspect');
					if (aspect) {
						lbMedia.style.aspectRatio = aspect;
					} else {
						lbMedia.style.aspectRatio = '';
					}
					lbImg.src = btn.getAttribute('data-full') || '';
					lbImg.alt = btn.getAttribute('data-title') || '';
					lbTitle.textContent = btn.getAttribute('data-title') || '';
					lbTag.textContent = btn.getAttribute('data-tag') || '';
					lbCounter.textContent = `${position + 1} / ${openers.length}`;
				};

				const open = (btn: HTMLElement) => {
					openers = visibleOpeners();
					lastFocused = btn;
					show(openers.indexOf(btn));
					lightbox.removeAttribute('hidden');
					document.body.style.overflow = 'hidden';
					void (lightbox as HTMLElement).offsetWidth;
					lightbox.classList.add('is-open');
					closeBtn.focus();
				};

				const close = () => {
					lightbox.classList.remove('is-open');
					document.body.style.overflow = '';
					const done = () => {
						lightbox.setAttribute('hidden', '');
						lbImg.removeAttribute('src');
					};
					if (reduceMotion) done();
					else window.setTimeout(done, 220);
					lastFocused?.focus();
				};

				document.querySelectorAll('[data-open-lightbox]').forEach((btn) => {
					btn.addEventListener('click', () => open(btn as HTMLElement));
				});
				lightbox.querySelectorAll('[data-lightbox-close]').forEach((el) => el.addEventListener('click', close));
				lightbox.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(position - 1));
				lightbox.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(position + 1));

				document.addEventListener('keydown', (e) => {
					if (lightbox.hasAttribute('hidden')) return;
					if (e.key === 'Escape') close();
					if (e.key === 'ArrowLeft') show(position - 1);
					if (e.key === 'ArrowRight') show(position + 1);
				});
			}
		</script>

		<style is:global>
			/* Regla accesible sr-only indispensable para evitar texto visible en negro sobre la imagen */
			.sr-only {
				position: absolute !important;
				width: 1px !important;
				height: 1px !important;
				padding: 0 !important;
				margin: -1px !important;
				overflow: hidden !important;
				clip: rect(0, 0, 0, 0) !important;
				white-space: nowrap !important;
				border: 0 !important;
			}

			:root,
			:root[data-theme='dark'] {
				--bg: #05090f;
				--bg-elevated: #0a1220;
				--panel: #0c1424;
				--border: rgba(125, 211, 252, 0.14);
				--border-strong: rgba(125, 211, 252, 0.32);
				--text: #eaf2fb;
				--text-dim: #8ea3bd;
				--accent: #38bdf8;
