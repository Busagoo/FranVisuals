				--accent-glow: rgba(56, 189, 248, 0.22);
				--on-accent: #04121f;
				--logo: #ffffff;
				--available: #2ee06f;
				--caption-veil: linear-gradient(to top, rgba(3, 8, 16, 0.94), rgba(3, 8, 16, 0));
				--shard: rgba(125, 211, 252, 0.16);
				--grid-line: rgba(255, 255, 255, 0.08);
			}

			/* Modo Claro Eléctrico y Resaltante con el Mismo Celeste Celeste #38bdf8 */
			:root[data-theme='light'] {
				--bg: #eaf4fd;
				--bg-elevated: #ffffff;
				--panel: #ffffff;
				--border: rgba(56, 189, 248, 0.35);
				--border-strong: rgba(56, 189, 248, 0.65);
				--text: #05090f;
				--text-dim: #1e293b;
				--accent: #38bdf8;
				--accent-bright: #0284c7;
				--accent-glow: rgba(56, 189, 248, 0.35);
				--on-accent: #04121f;
				--logo: #05090f;
				--available: #0f9d4f;
				--caption-veil: linear-gradient(to top, rgba(5, 9, 15, 0.94), rgba(5, 9, 15, 0));
				--shard: rgba(56, 189, 248, 0.28);
				--grid-line: rgba(255, 255, 255, 0.55);
			}

			:root {
				--font-display: 'Bebas Neue', 'Archivo', sans-serif;
				--font-body: 'Archivo', system-ui, sans-serif;
				--logo-src: url('/logo-mask.png');
			}

			* { box-sizing: border-box; }
			html {
				scroll-behavior: smooth;
				overflow-x: hidden;
				width: 100%;
				max-width: 100vw;
			}

			body {
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: var(--font-body);
				line-height: 1.5;
				overflow-x: hidden;
				width: 100%;
				max-width: 100vw;
				position: relative;
				transition: background 0.35s ease, color 0.35s ease;
			}

			a { color: inherit; }

			/* --- Fondo Animado --- */
			.bg-animated {
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				overflow: hidden;
				width: 100%;
				max-width: 100vw;
			}
			.bg-glow-1, .bg-glow-2, .bg-glow-3 {
				position: absolute;
				border-radius: 50%;
				filter: blur(80px);
				opacity: 0.35;
				animation: floatGlow 18s ease-in-out infinite alternate;
			}
			.bg-glow-1 {
				top: -10%;
				left: 15%;
				width: 45vw;
				height: 45vw;
				background: var(--accent-glow);
			}
			.bg-glow-2 {
				bottom: 10%;
				right: -5%;
				width: 50vw;
				height: 50vw;
				background: color-mix(in srgb, var(--accent) 25%, transparent);
				animation-delay: -6s;
				animation-duration: 22s;
			}
			.bg-glow-3 {
				top: 40%;
				left: -10%;
				width: 35vw;
				height: 35vw;
				background: var(--accent-glow);
				animation-delay: -11s;
				animation-duration: 25s;
			}

			.side-neon-left,
			.side-neon-right {
				position: absolute;
				top: 10%;
				bottom: 10%;
				width: 14px;
				background: var(--accent);
				filter: blur(26px);
				opacity: 0.42;
				pointer-events: none;
			}
			.side-neon-left { left: -7px; }
			.side-neon-right { right: -7px; }

			.bg-grid-dots {
				position: absolute;
				inset: 0;
				background-image: 
					linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
					linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
				background-size: 56px 56px;
				opacity: 0.65;
				animation: bgDrift 45s linear infinite;
			}

			.bg-grid-spotlight {
				position: absolute;
				inset: 0;
				background: radial-gradient(
					550px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
					color-mix(in srgb, var(--accent) 15%, transparent),
					transparent 78%
				);
				pointer-events: none;
			}

			@keyframes floatGlow {
				0% { transform: translate(0, 0) scale(1); }
				50% { transform: translate(6%, 8%) scale(1.15); }
				100% { transform: translate(-5%, 12%) scale(0.95); }
			}

			@keyframes bgDrift {
				0% { background-position: 0 0; }
				100% { background-position: 36px 72px; }
			}

			.skip-link {
				position: absolute;
				left: -9999px;
				top: 0;
				z-index: 100;
				background: var(--accent);
				color: var(--on-accent);
				padding: 0.7rem 1.1rem;
				font-weight: 700;
			}

			/* --- Logo Animado --- */
			.wordmark {
				display: inline-flex;
				align-items: center;
				gap: 0.6rem;
				text-decoration: none;
				color: var(--text);
			}
			.wordmark-mark {
				display: block;
				width: 2.3rem;
				height: 1.5rem;
				background: var(--logo);
				-webkit-mask-image: var(--logo-src);
				mask-image: var(--logo-src);
				-webkit-mask-repeat: no-repeat;
				mask-repeat: no-repeat;
				-webkit-mask-size: contain;
				mask-size: contain;
				-webkit-mask-position: center;
				mask-position: center;
				transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.35s ease;
				animation: logoFloat 4s ease-in-out infinite alternate;
			}
			.wordmark:hover .wordmark-mark {
				transform: scale(1.12) rotate(-4deg);
				filter: drop-shadow(0 0 10px var(--accent));
			}

			.wordmark-text {
				font-family: var(--font-display);
				font-size: 1.6rem;
				font-weight: 700;
				letter-spacing: 0.03em;
				line-height: 1;
			}
			.wordmark-text span { color: var(--accent); }

			.hero-mark {
				display: block;
				width: clamp(4.5rem, 10vw, 6.5rem);
				height: clamp(2.9rem, 6.5vw, 4.2rem);
				margin: 0 auto 1.2rem;
				background: var(--logo);
				-webkit-mask-image: var(--logo-src);
				mask-image: var(--logo-src);
				-webkit-mask-repeat: no-repeat;
				mask-repeat: no-repeat;
				-webkit-mask-size: contain;
				mask-size: contain;
				-webkit-mask-position: center;
				mask-position: center;
				animation: logoPulse 3.5s ease-in-out infinite alternate;
				filter: drop-shadow(0 0 20px var(--accent-glow));
			}

			@keyframes logoFloat {
				0% { transform: translateY(0); }
				100% { transform: translateY(-3px); }
			}

			@keyframes logoPulse {
				0% { transform: scale(1); filter: drop-shadow(0 0 12px var(--accent-glow)); }
				100% { transform: scale(1.06); filter: drop-shadow(0 0 28px var(--accent)); }
			}

			/* --- Header Flotante con Nav Links --- */
			.site-header {
				position: sticky;
				top: 0.85rem;
				z-index: 40;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem;
				max-width: min(82rem, calc(100vw - 1.2rem));
				margin: 0.85rem auto 0;
				padding: 0.85rem clamp(1.2rem, 3.5vw, 2.5rem);
				background: color-mix(in srgb, var(--bg) 84%, transparent);
				backdrop-filter: blur(16px);
				border: 1px solid var(--border-strong);
				clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
			}

			.header-nav {
				display: flex;
				align-items: center;
				gap: 1.5rem;
			}
			.nav-link {
				font-size: 0.9rem;
				font-weight: 600;
				text-decoration: none;
				color: var(--text-dim);
				transition: color 0.2s ease;
			}
			.nav-link:hover {
				color: var(--accent);
			}

			@media (max-width: 820px) {
				.header-nav { display: none; }
			}

			.header-actions { display: flex; align-items: center; gap: 0.75rem; }

			/* --- Hero Principal --- */
			.hero {
				position: relative;
				padding: clamp(3rem, 6vw, 5.5rem) clamp(1.25rem, 4vw, 3rem) clamp(2rem, 4vw, 3.5rem);
				text-align: center;
				overflow: hidden;
				width: 100%;
				max-width: 100vw;
			}
			.hero-inner { max-width: 58rem; margin: 0 auto; position: relative; z-index: 2; }
			
			.hero-kicker-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.6rem;
				font-size: 0.76rem;
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--accent);
				border: 1px solid var(--border-strong);
				padding: 0.45rem 1rem;
				margin: 0 0 1.2rem;
				clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
				background: color-mix(in srgb, var(--panel) 60%, transparent);
			}

			.dot {
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 50%;
				background: var(--available);
				animation: pulse 1.9s infinite;
			}

			@keyframes pulse {
				0% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.4; transform: scale(0.85); }
				100% { opacity: 1; transform: scale(1); }
			}

			.hero-title {
				font-family: var(--font-display);
				font-size: clamp(2.8rem, 7.5vw, 5.2rem);
				line-height: 0.95;
				letter-spacing: -1px;
				margin: 0 0 1rem;
				text-transform: uppercase;
			}

			.hero-tagline-sub {
				font-family: var(--font-display);
				font-size: clamp(1.1rem, 2.5vw, 1.6rem);
				letter-spacing: 0.02em;
				color: var(--text);
				margin: 0 0 1.4rem;
				text-transform: uppercase;
			}

			.hero-sub {
				color: var(--text-dim);
				font-size: clamp(1.02rem, 1.4vw, 1.2rem);
				max-width: 44rem;
				margin: 0 auto 2.2rem;
				line-height: 1.6;
			}

			.accent {
				color: var(--accent);
				display: inline-block;
				text-shadow: 0 0 10px var(--accent-glow), 0 0 22px color-mix(in srgb, var(--accent) 40%, transparent);
				animation: textPump 4.5s ease-in-out infinite alternate;
			}

			@keyframes textPump {
				0% { transform: scale(1); filter: drop-shadow(0 0 4px var(--accent-glow)); }
				50% { transform: scale(1.02); filter: drop-shadow(0 0 16px var(--accent)); }
				100% { transform: scale(1); filter: drop-shadow(0 0 4px var(--accent-glow)); }
			}

			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				justify-content: center;
				align-items: center;
				margin-bottom: 0.8rem;
			}

			.hero-microcopy {
				font-size: 0.84rem;
				color: var(--text-dim);
				margin: 0.5rem 0 2.5rem;
				font-weight: 500;
			}

			/* --- Statband con Glassmorphism --- */
			.statband {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 2.2rem;
				padding: 1.1rem 2.4rem;
				background: color-mix(in srgb, var(--panel) 45%, transparent);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid var(--border-strong);
				border-radius: 20px;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), inset 0 0 0 1px rgba(255, 255, 255, 0.08);
				transition: border-color 0.3s ease, box-shadow 0.3s ease;
			}
			.statband:hover {
				border-color: var(--accent);
				box-shadow: 0 12px 36px var(--accent-glow), inset 0 0 0 1px rgba(125, 211, 252, 0.22);
			}
			.stat-lead { display: flex; flex-direction: column; align-items: center; }
			.stat-lead-num { font-family: var(--font-display); font-size: clamp(2.2rem, 4vw, 2.8rem); color: var(--accent); line-height: 1; text-shadow: 0 0 16px var(--accent-glow); }
			.stat-lead-label { font-size: 0.76rem; font-weight: 700; text-transform: uppercase; color: var(--text-dim); letter-spacing: 0.05em; margin-top: 0.2rem; }

			.stat-rest { display: flex; gap: 2.2rem; list-style: none; margin: 0; padding: 0 0 0 2.2rem; border-left: 1px solid var(--border); }
			.stat-rest li { display: flex; flex-direction: column; align-items: center; }
			.stat-rest .n { font-family: var(--font-display); font-size: clamp(1.8rem, 3.2vw, 2.2rem); color: var(--text); line-height: 1; }
			.stat-rest .l { font-size: 0.72rem; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0.2rem; }

			@media (max-width: 640px) {
				.statband {
					display: grid;
					grid-template-columns: repeat(3, 1fr);
					width: 100%;
					max-width: 100%;
					padding: 0.85rem 0.4rem;
					gap: 0.25rem;
					border-radius: 14px;
				}
				.stat-lead { padding: 0; }
				.stat-lead-num { font-size: 1.65rem; }
				.stat-lead-label { font-size: 0.62rem; text-align: center; line-height: 1.25; }
				.stat-rest {
					display: contents;
					border-left: 0;
					padding: 0;
				}
				.stat-rest li {
					padding: 0 0.25rem;
					border-left: 1px solid var(--border);
				}
				.stat-rest .n { font-size: 1.55rem; }
				.stat-rest .l { font-size: 0.62rem; text-align: center; line-height: 1.25; }
			}

			/* --- Botones --- */
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				font-family: var(--font-body);
				font-weight: 700;
				font-size: 0.92rem;
				letter-spacing: 0.02em;
				text-decoration: none;
				padding: 0.72rem 1.25rem;
				border: 1px solid transparent;
				white-space: nowrap;
				cursor: pointer;
				clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
				transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
			}
			.btn-primary { background: var(--accent); color: var(--on-accent); }
			.btn-primary:hover { background: var(--accent-bright); transform: translateY(-2px); }
			.btn-ghost { border-color: var(--border-strong); color: var(--text); }
			.btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
			.btn-lg { padding: 1rem 1.8rem; font-size: 1.02rem; }

			/* --- Live Pill --- */
			.pill-live {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.76rem;
				font-weight: 700;
				letter-spacing: 0.09em;
				text-transform: uppercase;
				color: var(--text-dim);
				border: 1px solid var(--border-strong);
				padding: 0.42rem 0.85rem 0.42rem 0.65rem;
				margin: 0 0 1.5rem;
				clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
			}

			/* --- Theme toggle --- */
			.theme-toggle { border: 0; background: none; padding: 0; cursor: pointer; }
			.theme-toggle-track {
				position: relative;
				display: inline-flex;
				align-items: center;
				justify-content: space-between;
				width: 3.9rem;
				height: 2.2rem;
				padding: 0 0.5rem;
				border: 1px solid var(--border);
				background: var(--bg-elevated);
				clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
			}
			.theme-icon { position: relative; z-index: 2; }
			.theme-icon-sun { color: var(--text-dim); opacity: 0.5; }
			.theme-icon-moon { color: var(--on-accent); opacity: 1; }
			:root[data-theme='light'] .theme-icon-sun { color: var(--on-accent); opacity: 1; }
			:root[data-theme='light'] .theme-icon-moon { color: var(--text-dim); opacity: 0.5; }
			.theme-toggle-knob {
				position: absolute;
				top: 50%;
				left: 0.22rem;
				width: 1.6rem;
				height: 1.6rem;
				margin-top: -0.8rem;
				background: var(--accent);
				clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
				transform: translateX(1.68rem);
				transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
			}
			:root[data-theme='light'] .theme-toggle-knob { transform: translateX(0); }

			/* --- Estructura de Secciones --- */
			.section-container {
				max-width: 82rem;
				margin: 0 auto;
				padding: clamp(3.5rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3rem);
			}
			.section-elevated {
				background: color-mix(in srgb, var(--panel) 40%, transparent);
				border-top: 1px solid var(--border);
				border-bottom: 1px solid var(--border);
			}

			.section-head {
				text-align: center;
				max-width: 44rem;
				margin: 0 auto clamp(2.5rem, 5vw, 3.8rem);
			}
			.section-kicker {
				font-size: 0.78rem;
				font-weight: 800;
				letter-spacing: 0.12em;
				color: var(--accent);
				text-transform: uppercase;
				display: block;
				margin-bottom: 0.4rem;
			}
			.section-head h2 {
				font-family: var(--font-display);
				font-size: clamp(2.5rem, 5.5vw, 4rem);
				line-height: 0.98;
				letter-spacing: -0.5px;
				margin: 0 0 0.8rem;
				text-transform: uppercase;
			}
			.section-head p {
				color: var(--text-dim);
				font-size: clamp(1rem, 1.3vw, 1.12rem);
				margin: 0;
			}

			/* --- Grid de Servicios --- */
			.services-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
				gap: 1.5rem;
			}
			.service-card {
				background: var(--panel);
				border: 1px solid var(--border-strong);
				padding: 2.2rem 1.8rem;
				display: flex;
				flex-direction: column;
				clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
				transition: transform 0.3s ease, border-color 0.3s ease;
			}
			.service-card:hover {
				transform: translateY(-4px);
				border-color: var(--accent);
			}
			.service-card-featured {
				border-color: var(--accent);
				background: color-mix(in srgb, var(--panel) 85%, var(--accent-glow));
			}

			.service-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.2rem;
			}
			.service-icon {
				width: 3.2rem;
				height: 3.2rem;
				background: var(--accent-glow);
				color: var(--accent);
				display: grid;
				place-items: center;
				clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
			}
			.service-badge {
				font-size: 0.72rem;
				font-weight: 800;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--text-dim);
				padding: 0.3rem 0.6rem;
				border: 1px solid var(--border);
			}
			.badge-accent { background: var(--accent); color: var(--on-accent); border: 0; }

			.service-card h3 {
				font-family: var(--font-display);
				font-size: 1.9rem;
				margin: 0 0 0.5rem;
				letter-spacing: 0.02em;
			}
			.service-desc {
				color: var(--text-dim);
				font-size: 0.94rem;
				margin: 0 0 1.5rem;
				line-height: 1.5;
			}
			.service-list {
				list-style: none;
				padding: 0;
				margin: 0 0 2rem;
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
				font-size: 0.92rem;
			}
			.service-list .check { color: var(--accent); font-weight: 800; margin-right: 0.4rem; }
			.service-btn { margin-top: auto; width: 100%; justify-content: center; }

			/* --- Grid de Casos de Estudio --- */
			.cases-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
				gap: 1.8rem;
			}
			.case-card {
				background: var(--panel);
				border: 1px solid var(--border-strong);
				overflow: hidden;
				clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
			}
			.case-image { position: relative; overflow: hidden; aspect-ratio: 16/9; }
			.case-image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
			.case-card:hover .case-image img { transform: scale(1.04); }
			.case-tag {
				position: absolute;
				top: 0.8rem; left: 0.8rem;
				background: var(--accent);
				color: var(--on-accent);
				font-size: 0.7rem;
				font-weight: 800;
				padding: 0.25rem 0.55rem;
				text-transform: uppercase;
			}
			.case-body { padding: 1.5rem; }
			.case-body h3 { font-family: var(--font-display); font-size: 1.6rem; margin: 0 0 1rem; line-height: 1.1; }
			.case-metrics { display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.88rem; color: var(--text-dim); }
			.case-metrics strong { color: var(--text); }
			.metric-highlight { color: var(--accent); font-weight: 600; margin-top: 0.2rem; }

			/* --- Testimonios --- */
			.testimonials-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
				gap: 1.5rem;
			}
			.testimonial-card {
				background: var(--panel);
				border: 1px solid var(--border-strong);
				padding: 1.8rem;
				clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
			}
			.stars { color: #facc15; font-size: 1.1rem; margin-bottom: 0.8rem; letter-spacing: 2px; }
			.testimonial-quote { font-style: italic; font-size: 0.95rem; color: var(--text); margin: 0 0 1.2rem; line-height: 1.6; }
			.testimonial-author { display: flex; flex-direction: column; border-top: 1px solid var(--border); padding-top: 0.8rem; }
			.testimonial-author strong { font-size: 0.95rem; color: var(--text); }
			.testimonial-author span { font-size: 0.8rem; color: var(--text-dim); }

			/* --- FAQ Accordion --- */
			.faq-list { max-width: 50rem; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem; }
			.faq-item {
				background: var(--panel);
				border: 1px solid var(--border-strong);
				clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
			}
			.faq-question {
				padding: 1.2rem 1.5rem;
				font-weight: 700;
				font-size: 1.05rem;
				cursor: pointer;
				display: flex;
				justify-content: space-between;
				align-items: center;
				list-style: none;
			}
			.faq-question::-webkit-details-marker { display: none; }
			.faq-icon { font-family: var(--font-display); font-size: 1.6rem; color: var(--accent); transition: transform 0.3s ease; }
			.faq-item[open] .faq-icon { transform: rotate(45deg); }
			.faq-answer { padding: 0 1.5rem 1.4rem; color: var(--text-dim); font-size: 0.95rem; line-height: 1.6; border-top: 1px solid var(--border); margin-top: 0.5rem; padding-top: 1rem; }
			.faq-answer p { margin: 0; }

			/* --- Showcase & Carousel --- */
			.showcase { padding: 2rem clamp(1.25rem, 4vw, 3rem); text-align: center; overflow: hidden; position: relative; width: 100%; max-width: 100vw; }
			.showcase-head h2 { font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 3.8rem); margin: 0 0 0.4rem; text-transform: uppercase; }
			.showcase-head p { color: var(--text-dim); margin: 0 0 2rem; }

			.carousel { position: relative; max-width: 76rem; margin: 0 auto; overflow: hidden; width: 100%; }
			.carousel-stage { display: flex; justify-content: center; align-items: center; min-height: 24rem; perspective: 1000px; position: relative; touch-action: pan-y; overflow: hidden; width: 100%; }
			.slide {
				position: absolute;
				width: min(44rem, 88vw);
				aspect-ratio: 16 / 9;
				margin: 0;
				border: 1px solid var(--border-strong);
				background: var(--panel);
				overflow: hidden;
				opacity: 0;
				transform: scale(0.8) translateZ(-100px);
				transition: transform 0.4s ease, opacity 0.4s ease;
				clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
				pointer-events: none;
				user-select: none;
				box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
			}
			.slide img { display: block; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
			.slide figcaption {
				position: absolute; bottom: 0; left: 0; right: 0;
				padding: 1rem 1.2rem; background: var(--caption-veil);
				display: flex; gap: 0.8rem; align-items: center; z-index: 2; pointer-events: none;
			}

			.slide.is-current { opacity: 1; transform: scale(1) translateZ(0); pointer-events: auto; z-index: 3; }
			.slide.is-prev { opacity: 0.4; transform: translateX(-40%) scale(0.85); z-index: 2; }
			.slide.is-next { opacity: 0.4; transform: translateX(40%) scale(0.85); z-index: 2; }

			.carousel-controls { display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: 1.8rem; }
			.carousel-arrow {
				background: var(--panel); border: 1px solid var(--border-strong); color: var(--text);
				width: 2.6rem; height: 2.6rem; display: grid; place-items: center; cursor: pointer;
			}
			.carousel-dots { display: flex; gap: 0.5rem; }
			.carousel-dot {
				width: 0.65rem; height: 0.65rem; background: var(--border-strong); border: 0; cursor: pointer;
				transition: width 0.25s ease, background 0.25s ease;
			}
			.carousel-dot.is-active { background: var(--accent); width: 1.8rem; }

			/* --- Ticker Marquee Suave --- */
			.ticker {
				position: relative;
				background: var(--bg-elevated);
				border-top: 1px solid var(--border);
				border-bottom: 1px solid var(--border);
				padding: 0.85rem 0;
				overflow: hidden;
				white-space: nowrap;
			}
			.ticker::before,
			.ticker::after {
				content: '';
				position: absolute;
				top: 0; bottom: 0;
				width: clamp(3.5rem, 15vw, 12rem);
				z-index: 5;
				pointer-events: none;
			}
			.ticker::before { left: 0; background: linear-gradient(to right, var(--bg-elevated) 0%, color-mix(in srgb, var(--bg-elevated) 80%, transparent) 40%, transparent 100%); }
			.ticker::after { right: 0; background: linear-gradient(to left, var(--bg-elevated) 0%, color-mix(in srgb, var(--bg-elevated) 80%, transparent) 40%, transparent 100%); }

			.ticker-viewport { display: flex; width: max-content; animation: tickerSlide 50s linear infinite; }
			.ticker-group { display: flex; gap: 2.5rem; padding-right: 2.5rem; }
			.ticker-item { font-family: var(--font-display); font-size: 1.3rem; letter-spacing: 0.05em; color: var(--text-dim); text-transform: uppercase; }
			@keyframes tickerSlide { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

			/* --- Banner Wall Section con Hover Animado --- */
			.banner-wall-section { padding: 4rem 0; text-align: center; position: relative; }
			.banner-wall-head h2 { font-family: var(--font-display); font-size: clamp(2.5rem, 5.5vw, 3.8rem); margin: 0 0 0.4rem; text-transform: uppercase; }
			.banner-wall-head p { color: var(--text-dim); margin: 0 0 2.5rem; }
			.banner-wall-container {
				position: relative;
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
				overflow: hidden;
			}
			.banner-wall-container::before,
			.banner-wall-container::after {
				content: '';
				position: absolute;
				top: 0; bottom: 0;
				width: clamp(4rem, 18vw, 16rem);
				z-index: 10;
				pointer-events: none;
			}
			.banner-wall-container::before {
				left: 0;
				background: linear-gradient(to right, var(--bg) 0%, color-mix(in srgb, var(--bg) 85%, transparent) 45%, transparent 100%);
			}
			.banner-wall-container::after {
				right: 0;
				background: linear-gradient(to left, var(--bg) 0%, color-mix(in srgb, var(--bg) 85%, transparent) 45%, transparent 100%);
			}
			.marquee-row { display: flex; overflow: hidden; position: relative; }
			.marquee-row:hover .marquee-track { animation-play-state: paused; }
			.marquee-track { display: flex; gap: 1.2rem; flex-shrink: 0; width: max-content; }
			.row-left .marquee-track { animation: marqueeLeft 42s linear infinite; }
			.row-right .marquee-track { animation: marqueeRight 42s linear infinite; }

			@keyframes marqueeLeft { 0% { transform: translateX(0); } 100% { transform: translateX(-33.33333%); } }
			@keyframes marqueeRight { 0% { transform: translateX(-33.33333%); } 100% { transform: translateX(0); } }

			.banner-card {
				position: relative;
				margin: 0;
				width: 22rem;
				aspect-ratio: 16/9;
				border: 1px solid var(--border);
				background: var(--panel);
				overflow: hidden;
				flex-shrink: 0;
				clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
				transition: border-color 0.25s ease, transform 0.35s ease;
			}
			.banner-card img { display: block; width: 100%; height: 100%; object-fit: cover; }
			.banner-card:hover { border-color: var(--accent); transform: translateY(-3px); }

			.corner {
				position: absolute;
				width: 1.1rem;
				height: 1.1rem;
				border-color: var(--accent);
				opacity: 0;
				transition: opacity 0.25s ease;
				z-index: 2;
				pointer-events: none;
			}
			.corner-tl { top: 0.5rem; left: 0.5rem; border-top: 2px solid; border-left: 2px solid; }
			.corner-tr { top: 0.5rem; right: 0.5rem; border-top: 2px solid; border-right: 2px solid; }
			.corner-bl { bottom: 0.5rem; left: 0.5rem; border-bottom: 2px solid; border-left: 2px solid; }
			.corner-br { bottom: 0.5rem; right: 0.5rem; border-bottom: 2px solid; border-right: 2px solid; }
			.banner-card:hover .corner { opacity: 1; }

			.banner-card figcaption {
				position: absolute;
				left: 0; right: 0; bottom: 0;
				display: flex; align-items: center; gap: 0.6rem;
				padding: 0.75rem 0.9rem;
				background: var(--caption-veil);
				transform: translateY(15%);
				opacity: 0;
				transition: transform 0.25s ease, opacity 0.25s ease;
				z-index: 2;
				pointer-events: none;
			}
			.banner-card:hover figcaption { transform: translateY(0); opacity: 1; }

			.tag {
				font-size: 0.64rem;
				font-weight: 800;
				letter-spacing: 0.07em;
				text-transform: uppercase;
				color: var(--on-accent);
				background: var(--accent);
				padding: 0.2rem 0.42rem;
				flex-shrink: 0;
			}
			figcaption .title {
				font-size: 0.8rem;
				font-weight: 600;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				color: #f4f9ff;
			}

			.card-open {
				position: absolute; inset: 0; width: 100%; height: 100%;
				border: 0; padding: 0; background: transparent;
				cursor: zoom-in; z-index: 3;
			}
			.card-zoom {
				position: absolute; top: 0.6rem; right: 0.6rem;
				display: grid; place-items: center;
				width: 2rem; height: 2rem;
				color: var(--on-accent); background: var(--accent);
				clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
				opacity: 0; transform: translateY(-4px);
				transition: opacity 0.25s ease, transform 0.25s ease;
			}
			.banner-card:hover .card-zoom { opacity: 1; transform: translateY(0); }

			.see-more-wrapper { display: flex; justify-content: center; margin-top: 2.2rem; }
			.see-more-btn { width: auto !important; max-width: max-content !important; padding: 0.75rem 1.5rem !important; }

			/* --- CTA Final --- */
			.cta {
				text-align: center;
				padding: clamp(4rem, 8vw, 6.5rem) 1.5rem;
				background: color-mix(in srgb, var(--panel) 80%, var(--accent-glow));
				border-top: 1px solid var(--border-strong);
			}
			.cta h2 { font-family: var(--font-display); font-size: clamp(2.4rem, 6vw, 4rem); line-height: 0.98; margin: 0 0 2rem; text-transform: uppercase; }

			/* --- Botón Flotante Móvil de WhatsApp --- */
			.mobile-whatsapp-float {
				display: none;
			}
			@media (max-width: 560px) {
				.mobile-whatsapp-float {
					position: fixed;
					bottom: 1.2rem;
					right: 1.2rem;
					z-index: 99;
					display: flex;
					align-items: center;
					gap: 0.6rem;
					background: #25d366;
					color: #ffffff;
					font-weight: 800;
					font-size: 0.9rem;
					padding: 0.8rem 1.3rem;
					border-radius: 50px;
					text-decoration: none;
					box-shadow: 0 8px 25px rgba(37, 211, 102, 0.45);
					animation: pulseWa 2s infinite;
				}
				@keyframes pulseWa {
					0% { transform: scale(1); }
					50% { transform: scale(1.04); }
					100% { transform: scale(1); }
				}
			}

			/* --- Lightbox Dialog Completo con Título de Proyecto y Rubro --- */
			.lightbox { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 1.5rem; }
			.lightbox[hidden] { display: none; }
			.lightbox-scrim { position: absolute; inset: 0; background: rgba(3, 8, 16, 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
			.lightbox-panel { position: relative; width: fit-content; max-width: min(92vw, 78rem); z-index: 2; display: flex; flex-direction: column; align-items: center; }
			.lightbox-figure { margin: 0; background: var(--panel); border: 1px solid var(--border-strong); clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px)); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6); display: flex; flex-direction: column; width: fit-content; max-width: 100%; }
			.lightbox-media { position: relative; overflow: hidden; display: flex; justify-content: center; align-items: center; width: fit-content; max-width: 100%; margin: 0 auto; }
			.lightbox-media img { display: block; width: auto; height: auto; max-width: min(92vw, 78rem); max-height: calc(82vh - 4.5rem); object-fit: contain; }
			.lightbox-caption { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.9rem 1.2rem; background: color-mix(in srgb, var(--bg-elevated) 90%, transparent); backdrop-filter: blur(12px); border-top: 1px solid var(--border); width: 0; min-width: 100%; box-sizing: border-box; }
			.lightbox-info { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; min-width: 0; }
			.lightbox-title { font-size: 1rem; font-weight: 700; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.lightbox-counter { font-size: 0.85rem; color: var(--accent); font-weight: 800; letter-spacing: 0.05em; white-space: nowrap; }
			
			.lightbox-btn { position: absolute; background: var(--panel); border: 1px solid var(--border-strong); color: var(--text); width: 2.8rem; height: 2.8rem; display: grid; place-items: center; cursor: pointer; z-index: 5; transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease; }
			.lightbox-btn:hover { border-color: var(--accent); color: var(--accent); }
			.lightbox-close { top: -1.2rem; right: -1.2rem; }
			.lightbox-prev { top: 50%; left: -1.2rem; transform: translateY(-50%); }
			.lightbox-prev:hover { transform: translateY(-50%) scale(1.08); }
			.lightbox-next { top: 50%; right: -1.2rem; transform: translateY(-50%); }
			.lightbox-next:hover { transform: translateY(-50%) scale(1.08); }

			/* --- Footer --- */
			.site-footer {
				background: var(--bg-elevated);
				border-top: 1px solid var(--border-strong);
				padding: 4rem 1.5rem 2rem;
